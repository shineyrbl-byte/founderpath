# Pick one AI provider. If both keys are set, AI_PROVIDER decides (claude | gemini).
# Free: get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a Gemini model (default: gemini-flash-latest)
GEMINI_MODEL=
# Paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_PROVIDER=
# Set to 1 to force template-based demo mode even with a key
FOUNDERPATH_DEMO=0
